# /etc/nginx/sites-available/storm-licences
#
# TLS terminates here; the server itself only listens on 127.0.0.1.
# Get a certificate with:  certbot --nginx -d keys.example.com

server {
    listen 80;
    listen [::]:80;
    server_name keys.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name keys.example.com;

    ssl_certificate     /etc/letsencrypt/live/keys.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/keys.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # nothing this server accepts is large, and the webhook body is buffered
    client_max_body_size 256k;

    location / {
        proxy_pass http://127.0.0.1:8710;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Proto $scheme;

        # $remote_addr, NOT $proxy_add_x_forwarded_for: the second one keeps
        # whatever the caller sent, so anyone could claim a different address
        # and get a fresh rate limit bucket.
        proxy_set_header X-Forwarded-For   $remote_addr;

        proxy_connect_timeout 5s;
        proxy_read_timeout    20s;
    }
}
